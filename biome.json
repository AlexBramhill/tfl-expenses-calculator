{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"formatter": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style": {
				"noRestrictedImports": {
					"level": "error",
					"options": {
						"patterns": [
							{
								"group": ["./**", "../**"],
								"message": "Use the @/ alias instead of a relative import."
							}
						]
					}
				}
			}
		}
	},
	"assist": {
		"enabled": true
	},
	"files": {
		"includes": ["**", "!dist"]
	}
}
