{
	"name": "tfl-expenses-calculator",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"bin": {
		"tfl": "dist/tfl.js"
	},
	"scripts": {
		"build": "node esbuild.config.mjs && chmod +x dist/tfl.js",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"start": "tsx src/main.tsx",
		"screenshot": "bash screenshot/run.sh",
		"format": "biome format .",
		"lint": "biome lint .",
		"check": "biome check .",
		"fix": "biome check --write .",
		"fix-unsafe": "biome check --write --unsafe ."
	},
	"dependencies": {
		"@inkjs/ui": "^2.0.0",
		"ink": "^7.0.3",
		"papaparse": "^5.7.0",
		"react": "^19.3.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/node": "^24.19.2",
		"@types/papaparse": "^5.5.2",
		"@types/react": "^19.3.0",
		"esbuild": "^0.28.2",
		"ink-testing-library": "^4.0.0",
		"tsx": "^4.23.15",
		"typescript": "~7.0.2",
		"vitest": "^5.0.5"
	}
}
