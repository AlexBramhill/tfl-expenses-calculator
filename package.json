{
	"name": "tfl-expenses-calculator",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"bin": {
		"tfl": "dist/tfl.js"
	},
	"scripts": {
		"build": "node esbuild.config.mjs && chmod +x dist/tfl.js",
		"start": "tsx src/main.tsx",
		"format": "biome format .",
		"lint": "biome lint .",
		"check": "biome check .",
		"fix": "biome check --write .",
		"fix-unsafe": "biome check --write --unsafe ."
	},
	"dependencies": {
		"ink": "^7.0.3",
		"papaparse": "^5.5.3",
		"react": "^19.2.6",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.15",
		"@types/node": "^24.12.3",
		"@types/papaparse": "^5.5.2",
		"@types/react": "^19.2.14",
		"esbuild": "^0.28.1",
		"tsx": "^4.22.0",
		"typescript": "~6.0.2"
	}
}
